{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/ir-camera-schema",
  "description": "Metadata to describe ir-camera diagnostics",
  "type": "object",
  "required": [ "deviceInformation", "deviceSettings", "location" ],
  "properties": {
    "deviceInformation": {
      "allOf": [
        {
          "$ref": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/base-device"
        },
        {
          "required": [
            "make",
            "model",
            "resolution",
            "serialNumber",
            "spectralRange",
            "temperatureRange"
          ]
        }
      ]
    },
    "deviceSettings": {
      "type": "object",
      "required": [ "emissivity", "framerate" ],
      "properties": {
        "emissivity": {
          "type": "number"
        },
        "framerate": {
          "type": "number",
          "units": "qudt:HZ"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [ "portID", "viewportID" ],
      "properties": {
        "portID": {
          "type": "string"
        },
        "viewportID": {
          "type": "string"
        }
      }
    }
  }
}
