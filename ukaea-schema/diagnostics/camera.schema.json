{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/camera",
  "description": "Metadata to describe camera diagnostics",
  "type": "object",
  "required": [ "cameraInformation", "lensInformation", "captureSettings" ],
  "properties": {
    "cameraInformation": { "$anchor": "CameraInformation",
      "type": "object",
      "required": [ "make", "model"],
      "properties": {
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "resolution": {
          "type": "object",
          "required": [ "Y", "X" ],
          "properties": {
            "X": {
              "description": "The camera resolution in pixels, represented as width.",
              "type": "integer",
              "units": "qudt:px"
            },
            "Y": {
              "description": "The camera resolution in pixels, represented as height.",
              "type": "integer",
              "units": "qudt:px"
            }
          }
        },
        "serialNumber": {
          "type": "string"
        },
                "spectralRange": {
          "type": "object",
          "required": [ "minimum", "maximum" ],
          "properties": {
            "maximum": {
              "type": "number",
              "units": "qudt:MicroM"
            },
            "minimum": {
              "type": "number",
              "units": "qudt:MicroM"
            }
          }
        },
        "temperatureRange": {
          "type": "object",
          "required": [ "minimum", "maximum" ],
          "properties": {
            "maximum": {
              "type": "number",
              "units": "qudt:DEG_C"
            },
            "minimum": {
              "type": "number",
              "units": "qudt:DEG_C"
            }
          }
        }
      }
    },
    "captureSettings": {
      "type": "object",
      "required": [ "imageAcquisitionRate", "imageNoise" ],
      "properties": {
        "imageAcquisitionRate": {
          "description": "The rate at which images are acquired, measured in Hertz.",
          "type": "number",
          "unit": "qudt:Hertz"
        },
        "imageNoise": {
          "description": "The noise level in the image, typically measured as a signal-to-noise ratio.",
          "type": "number"
        },
        "imageScale": {
          "description": "The scale of the image in millimeters per pixel (mm/pixel) or similar.",
          "type": "number",
          "unit": "qudt:MilliM-PER-Pixel"
        }
      }
    },
    "lensInformation": {
      "type": "object",
      "required": [ "make", "model", "focalLength", "aperture" ],
      "properties": {
        "aperture": {
          "type": "string"
        },
        "fieldOfViewX": {
          "description": "The field of view in pixels, represented as width.",
          "type": "integer",
          "units": "qudt:px"
        },
        "fieldOfViewY": {
          "description": "The field of view in pixels, represented as height.",
          "type": "integer",
          "units": "qudt:px"
        },
        "focalLength": {
          "type": "number"
        },
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        }
      }
    }
  }
}