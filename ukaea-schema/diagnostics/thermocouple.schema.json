{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/thermocouple",
  "description": "Metadata to describe thermocouple diagnostic",
  "type": "object",
  "required": [ "diagnosticInformation", "thermocoupleTC" ],
  "properties": {
    "thermocoupleTC": {
      "type": "object",
      "required": [ "attachmentType", "tcType", "circleDiameter", "noiseFloor"],
      "properties": {
        "attachmentType": {
          "description": "[-]",
          "type": "string",
          "example": "spot weld with inert gas shield"
        },
        "tcType": {
          "description": "[-]",
          "type": "string",
          "example": "K"
        },
        "circleDiameter": {
          "type": "number"
        },
        "noiseFloor": {
          "type": "string"
        }
      }
    },
    "diagnosticInformation": {
      "type": "object",
      "required": [ "diagnosticID"],
      "properties": {
        "diagnosticID": {
          "type": "string",
          "descripiton": "[-]"
        }
      }
    }
  }
}
