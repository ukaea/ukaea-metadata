{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/thermocouple",
  "description": "Metadata to describe thermocouple diagnostic",
  "type": "object",
  "required": [ "deviceInformation", "deviceSetup" ],
  "properties": {
    "deviceInformation": {
      "type": "object",
      "required": [ "attachmentType", "tcType" ],
      "properties": {
        "attachmentType": {
          "description": "[-]",
          "type": "string",
          "example": "spot weld with inert gas shield"
        },
        "tcType": {
          "description": "[-]",
          "type": "string",
          "example": "K"
        }
      }
    },
    "deviceSetup": {
      "type": "object",
      "required": [ "dataChannel", "location" ],
      "properties": {
        "dataChannel": {
          "type": "string",
          "descripiton": "[-]"
        },
        "location": {
          "type": "string",
          "descripiton": "[-]"
        }
      }
    }
  }
}
