{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fusion/schemas/1.0.0/diagnostics/thermocouple",
  "description": "Metadata to describe thermocouple diagnostic",
  "type": "object",
  "required": [ "thermocouple" ],
  "properties": {
    "thermocouple": {
      "type": "object",
      "required": [ "attachmentType", "tcType", "circleDiameter", "noiseFloor"],
      "properties": {
        "attachmentType": {
          "type": "string",
          "description": "method used to physically attach thermocouple to its target",
          "example": "spot weld with inert gas shield"
        },
        "tcType": {
          "type": "string",
          "description": "material composition of the thermocouple",
          "example": "K"
        },
        "circleDiameter": {
          "type": "number",
          "description": "thermocouple sensitive tip diameter"
        },
        "noiseFloor": {
          "type": "string",
          "description": "minimum measurable signal level"
        }
      }
    }
  }
}
