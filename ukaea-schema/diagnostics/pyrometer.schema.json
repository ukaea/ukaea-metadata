{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ukaea:experiment:hive:diagnostics:pyrometer-schema",
  "description": "Metadata to describe pyrometer diagnostics",
  "type": "object",
  "required": [ "deviceInformation", "deviceSettings", "location" ],
  "properties": {
    "deviceInformation": {
      "type": "object",
      "required": [
        "make",
        "model",
        "serialNumber",
        "temperatureRange",
        "spectralRange"
      ],
      "properties": {
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serialNumber": {
          "type": "integer"
        },
        "spectralRange": {
          "type": "object",
          "required": [ "minimum", "maximum" ],
          "properties": {
            "maximum": {
              "type": "number",
              "units": "qudt:MicroM"
            },
            "minimum": {
              "type": "number",
              "units": "qudt:MicroM"
            }
          }
        },
        "temperatureRange": {
          "type": "object",
          "required": [ "minimum", "maximum" ],
          "properties": {
            "maximum": {
              "type": "number",
              "units": "qudt:DEG_C"
            },
            "minimum": {
              "type": "number",
              "units": "qudt:DEG_C"
            }
          }
        }
      }
    },
    "deviceSettings": {
      "type": "object",
      "required": [ "emissivity", "framerate" ],
      "properties": {
        "emissivity": {
          "type": "number"
        },
        "framerate": {
          "type": "number",
          "units": "qudt:HZ"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [ "portID", "viewportID" ],
      "properties": {
        "portID": {
          "type": "string"
        },
        "viewportID": {
          "type": "string"
        }
      }
    }
  }
}
