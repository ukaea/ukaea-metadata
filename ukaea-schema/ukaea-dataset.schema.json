{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/ukaea-dataset",
    "title": "UKAEA Dataset Schema",
    "type": "object",
    "properties": {
        "contactEmail": {
            "type": "string",
            "format": "email"
        },
        "creationTime": {
            "type": "string",
            "format": "date-time"
        },
        "owner": {
            "type": "string"
        },
        "type": {
            "type": "string"
        },
        "sourceFolder": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "experimentNumber": {
            "type": "string"
        },
        "additional": {
            "type": "object"
        },
        "instrument": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [ "creationTime", "type", "sourceFolder", "description" ]
}
