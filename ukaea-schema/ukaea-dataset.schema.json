{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/ukaea-dataset",
    "title": "UKAEA Dataset Schema",
    "type": "object",
    "properties": {
        "contactPoint": {
            "description": "Relevant contact information for the dataset. ",
            "type": "string",
            "format": "email"
        },
        "issued": {
            "description": "Date of formal issuance (e.g., publication) of the dataset.",
            "type": "string",
            "format": "date-time"
        },
        "creator": {
            "description": "The entity responsible for producing the Dataset.",
            "type": "string"
        },
        "type": {
            "description": "The nature or genre of the dataset.",
            "type": "string"
        },
        "distribution": {
            "description": "An available distribution of the dataset.",
            "type": "string"
        },
        "description": {
            "description": "A free-text account of the dataset.",
            "type": "string"
        },
        "experimentNumber": {
            "type": "string"
        },
        "additional": {
            "type": "object"
        },
        "instrument": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "issued",
        "type",
        "distribution",
        "description"
    ]
}