{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/mrf/mrf-stageone",
    "description": "Metadata schema MRF experiments before directory creation",
    "type": "object",
    "required": [
        "seid",
        "bookingStart",
        "bookingEnd",
        "workCategory",
        "sampleSplit",
        "tritium",
        "beryllium",
        "betaGamma"
    ],
    "properties": {
        "labLocation": {
            "type": "string",
            "default": "MRF"
        },
        "seid": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "$comment": "4 digits of the SEID (equipment identity number)"
        },
        "seidDescription": {
            "type": "string",
            "$comment": "Written identifier of equipment in booking system"
        },
        "jobId": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "$comment": "First 2 digits represent year, last 3 digits represent incremental number"
        },
        "sessionId": {
            "type": "string",
            "$comment": "Incremental session ID across a single job"
        },
        "sampleId": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "$comment": "Unique identifier for the sample(s), not part of Salesforce MVP"
        },
        "bookingStart": {
            "type": "string",
            "format": "date-time"
        },
        "bookingEnd": {
            "type": "string",
            "format": "date-time"
        },
        "internalUser": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "firstName": { "type": "string" },
                    "lastName": { "type": "string" },
                    "email": { "type": "string" }
                }
            }
        },
        "externalUser": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "firstName": { "type": "string" },
                    "lastName": { "type": "string" },
                    "email": { "type": "string" }
                }
            },
            "$comment": "Would lead to an institution"
        },
        "institution": {
            "type": "string"
        },
        "scientificSupport": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "firstName": { "type": "string" },
                    "lastName": { "type": "string" },
                    "email": { "type": "string" }
                }
            }
        },
        "notes": {
            "type": "string"
        },
        "workCategory": {
            "enum": [
                "User",
                "Engineering",
                "Maintenance",
                "Environment",
                "Repair"
            ]
        },
        "sampleSplit": {
            "type": "boolean"
        },
        "splitSampleId": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "tritium": {
            "type": "boolean"
        },
        "beryllium": {
            "type": "boolean"
        },
        "betaGamma": {
            "type": "boolean"
        }
    },
    "if": {
        "properties": {
            "workCategory": {
                "const": "User"
            }
        }
    },
    "then": {
        "required": ["jobId"]
    },
    "dependentRequired": {
        "externalUser": ["institution"]
    }
}
