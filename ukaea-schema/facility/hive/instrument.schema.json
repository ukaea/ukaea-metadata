{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/hive/instrument",
    "description": "Metadata schema for a HIVE instrument",
    "type": "object",
    "required": [
        "instrumentID",
        "instrumentName",
        "instrumentType",
        "instrument"
    ],
    "properties": {
        "instrumentID": {
            "type": "string",
            "format": "uuid"
        },
        "instrumentName": {
            "type": "string"
        },
        "instrumentType": {
            "type": "string"
        },
        "instrument": {
            "oneOf": [
                {
                    "$ref": "https://w3id.org/fusion/schemas/1.0.0/instruments/dic"
                },
                {
                    "$ref": "https://w3id.org/fusion/schemas/1.0.0/instruments/thermocouple"
                },
                {
                    "$ref": "https://w3id.org/fusion/schemas/1.0.0/instruments/camera"
                },
                {
                    "$ref": "https://w3id.org/fusion/schemas/1.0.0/instruments/flowmeter"
                },
                {
                    "$ref": "https://w3id.org/fusion/schemas/1.0.0/instruments/pyrometer"
                },
                {
                    "$ref": "https://w3id.org/fusion/schemas/1.0.0/instruments/ir-camera"
                }
            ]
        }
    }
}
