{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/hive/campaign",
    "description": "Metadata schema for a HIVE campaign",
    "type": "object",
    "required": [ "campaignUUID", "campaignStart" ],
    "properties": {
        "campaignUUID": {
            "type": "string",
            "format": "uuid"
        },
        "campaignStart": {
            "type": "string",
            "format": "date-time"
        },
        "campaignEnd": {
            "type": "string",
            "format": "date-time"
        }
    }
}
