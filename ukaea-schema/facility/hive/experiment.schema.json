{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/hive/experiment",
    "description": "Metadata schema for a HIVE experiment",
    "type": "object",
    "required": [
        "campaignUUID",
        "experimentUUID",
        "leadInvestigator",
        "heatingType",
        "sampleCooling"
    ],
    "properties": {
        "campaignUUID": {
            "type": "string",
            "format": "uuid"
        },
        "campaignTitle": {
            "type": "string"
        },
        "experimentUUID": {
            "type": "string",
            "format": "uuid"
        },
        "experimentStart": {
            "type": "string",
            "format": "date-time"
        },
        "experimentEnd": {
            "type": "string",
            "format": "date-time"
        },
        "experimentTitle": {
            "type": "string"
        },
        "heatingType": {
            "enum": [ "Induction", "DC" ]
        },
        "sampleCooling": {
            "type": "boolean"
        },
        "leadInvestigator": {
            "type": "object",
            "description": "Information about the principal scientist or researcher leading the experiment",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            }
        },
        "customer": {
            "type": "object",
            "properties": {
                "organisation": {
                    "type": "string",
                    "description": "Name of organisation / group / company conducting the experiment"
                },
                "contactPerson": {
                    "type": "object",
                    "description": "Information about teh designated person someone from the customer leading the experiment",
                    "properties": {
                        "email": {
                            "type": "string",
                            "format": "email"
                        },
                        "firstName": {
                            "type": "string"
                        },
                        "lastName": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
