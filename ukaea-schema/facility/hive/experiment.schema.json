{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/facility/hive/experiment",
  "description": "Metadata schema for a HIVE campaign",
  "type": "object",
  "required": [
    "campaignID",
    "experimentID",
    "leadInvestigator",
    "heatingType",
    "sampleCooling",
    "pulse"
  ],
  "properties": {
    "campaignID": {
      "$comment": "Can be refd to the campaign.schema.json#campaignID?",
      "type": "string",
      "example": "HIVE-XXXX"
    },
    "campaignTitle": {
      "type": "string"
    },
    "experimentEnd": {
      "type": "string",
      "format": "date-time"
    },
    "experimentID": {
      "type": "string",
      "example": "HIVE-E-XXXX"
    },
    "experimentTitle": {
      "type": "string"
    },
    "experimentStart": {
      "type": "string",
      "format": "date-time"
    },
    "heatingType": {
      "$comment": "Discuss with JP and SC if this can move to the pulse level.",
      "enum": [ "Induction", "DC" ]
    },
    "inductionCoilID": {
      "type": "string"
    },
    "leadInvestigator": {
      "$comment": "Link to type @person",
      "$ref": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/person"
      }
    },
    "customer": {
      "$comment": "Customer's (organization) name and contact person's details",
      "type": "object",
      "properties": {
        "organisation": {
          "$comment": "organisation / group / company's name",
          "type": "string"
        },
        "contactPerson": {
          "$ref": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/person"
        }
    },
    "sampleCooling": {
      "type": "boolean"
    }
  }
}
