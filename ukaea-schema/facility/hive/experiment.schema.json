{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/hive/experiment",
    "description": "Metadata schema for a HIVE experiment",
    "type": "object",
    "properties": {
        "ID": {
            "type": "string",
            "description": "A unique identifier for the experiment"
        },
        "startDate": {
            "type": "string",
            "format": "date"
        },
        "endDate": {
            "type": "string",
            "format": "date"
        },
        "description": {
            "type": "string"
        },
        "leadInvestigator": {
            "type": "object",
            "description": "Information about the principal scientist or researcher leading the experiment",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            }
        },
        "customer": {
            "type": "object",
            "properties": {
                "organisation": {
                    "type": "string",
                    "description": "Name of organisation / group / company conducting the experiment"
                },
                "contactPerson": {
                    "type": "object",
                    "description": "Information about the designated person from the customer leading the experiment",
                    "properties": {
                        "email": {
                            "type": "string",
                            "format": "email"
                        },
                        "firstName": {
                            "type": "string"
                        },
                        "lastName": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "required": [
        "ID",
        "startDate",
        "description",
        "leadInvestigator"
    ]
}
