{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/facility/hive/experiment",
  "description": "Metadata schema for a HIVE campaign",
  "type": "object",
  "required": [
    "campaignID",
    "experimentID",
    "leadInvestigator",
    "heatingType",
    "sampleCooling"
  ],
  "properties": {
    "campaignID": {
      "$comment": "Can be refd to the campaign.schema.json#campaignID?",
      "type": "string",
      "example": "HIVE-XXXX"
    },
    "campaignTitle": {
      "type": "string"
    },
    "experimentEnd": {
      "type": "string",
      "format": "date-time"
    },
    "experimentID": {
      "type": "string",
      "example": "HIVE-E-XXXX"
    },
    "experimentTitle": {
      "type": "string"
    },
    "experimentStart": {
      "type": "string",
      "format": "date-time"
    },
    "heatingType": {
      "$comment": "Discuss with JP and SC if this can move to the pulse level.",
      "enum": [ "Induction", "DC" ]
    },
    "leadInvestigator": {
      "type": "object",
      "$comment": "Link to type @person",
      "description": "Information about the principal scientist or researcher leading the experiment",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        }
      }
    },
    "customer": {
      "type": "object",
      "properties": {
        "organisation": {
          "type": "string",
          "description": "Name of organisation / group / company conducting the experiment"
        },
        "contactPerson": {
          "type": "object",
          "description": "Information about teh designated person someone from the customer leading the experiment",
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "firstName": {
              "type": "string"
            },
            "lastName": {
              "type": "string"
            }
          }
        }
      }
    },
    "sampleCooling": {
      "type": "boolean"
    }
  }
}

