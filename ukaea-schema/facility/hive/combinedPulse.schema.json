{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/hive/combinedPulse",
    "description": "Metadata schema for combined pulse",
    "type": "object",
    "required": [
        "manual",
        "processing",
        "annotation"
    ],
    "properties": {
        "manual": {
            "$ref": "ukaea-schema/facility/hive/pulse.schema.json"
        },
        "processing": {
            "$ref": "ukaea-schema/facility/hive/postprocess.schema.json"
        },
        "annotation": {
            "type": "object",
            "required": [
                "pulseQuality"
            ],
            "properties": {
                "comment": {
                    "type": "string"
                },
                "pulseQuality": {
                    "type": "string"
                }
            }
        }
    }
}