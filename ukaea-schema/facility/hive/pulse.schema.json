{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fuel/schemas/1.0.0/facility/hive/pulse",
    "description": "Metadata schema for a HIVE pulse",
    "type": "object",
    "properties": {
        "pulseNumber": {
            "type": "number"
        },
        "sampleNumber": {
            "type": "string"
        },
        "dataCaptureStart": {
            "type": "string",
            "format": "date-time"
        },
        "pulseStart": {
            "type": "string",
            "format": "date-time"
        },
        "pulseEnd": {
            "type": "string",
            "format": "date-time"
        },
        "pulseDuration": {
            "type": "number",
            "unit": "qudt:SEC"
        },
        "operator1": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [ "email", "firstName", "lastName" ]
        },
        "operator2": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [ "email", "firstName", "lastName" ]
        },
        "heatingInformation": {
            "type": "object",
            "properties": {
                "heatingType": {
                    "enum": [ "Induction", "DC" ]
                },
                "currentType": {
                    "enum": [ "AC", "DC" ]
                },
                "inputPower": {
                    "type": "number",
                    "unit": "qudt:KiloW"
                },
                "inputCurrent": {
                    "type": "number",
                    "unit": "qudt:A"
                },
                "inputVoltage": {
                    "type": "number",
                    "unit": "qudt:V"
                },
                "measuredPower": {
                    "type": "number"
                },
                "outputFrequency": {
                    "type": "number"
                },
                "outputVoltage": {
                    "type": "number"
                },
                "outputCurrent": {
                    "type": "number"
                }
            },
            "required": [
                "heatingType",
                "currentType",
                "measuredPower",
                "outputFrequency",
                "outputVoltage",
                "outputCurrent"
            ],
            "if": {
                "properties": {
                    "currentType": {
                        "const": "DC"
                    }
                }
            },
            "then": {
                "required": [ "inputPower", "inputCurrent", "inputVoltage" ]
            }
        },
        "coolantInformation": {
            "type": "object",
            "properties": {
                "sampleCooling": {
                    "type": "boolean"
                },
                "coolantType": {
                    "type": "string"
                },
                "targetCoolantFlow": {
                    "type": "number"
                },
                "targetCoolantTemperature": {
                    "type": "number"
                },
                "measuredCoolantFlow": {
                    "type": "number"
                },
                "coolantFlowVariance": {
                    "type": "number"
                },
                "coolantPressureIn": {
                    "type": "number"
                },
                "coolantPressureOut": {
                    "type": "number"
                },
                "deltaPressure": {
                    "type": "number"
                },
                "coolantTemperatureIn": {
                    "type": "number"
                },
                "coolantTemperatureInVariance": {
                    "type": "number"
                },
                "coolantTemperatureOut": {
                    "type": "number"
                },
                "coolantTemperatureOutVariance": {
                    "type": "number"
                },
                "deltaTemperature": {
                    "type": "number"
                }
            },
            "required": [
                "sampleCooling",
                "coolantType",
                "targetCoolantFlow",
                "targetCoolantTemperature",
                "measuredCoolantFlow",
                "coolantFlowVariance",
                "coolantPressureIn",
                "coolantPressureOut",
                "deltaPressure",
                "coolantTemperatureIn",
                "coolantTemperatureInVariance",
                "coolantTemperatureOut",
                "coolantTemperatureOutVariance",
                "deltaTemperature"
            ]
        },
        "thermocoupleInformation": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "thermocoupleId": {
                        "type": "number"
                    },
                    "maxValue": {
                        "type": "number"
                    }
                },
                "required": [ "thermocoupleId", "maxValue" ]
            }
        },
        "comment": {
            "type": "string"
        },
        "pulseQuality": {
            "enum": [ "Success", "Fail" ]
        },
        "experimentNumber": {
            "type": "string"
        },
        "configurationUUID": {
            "type": "string",
            "format": "uuid"
        },
        "diagnostics": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "minItems": 1
            }
        }
    },
    "required": [
        "pulseNumber",
        "sampleNumber",
        "dataCaptureStart",
        "pulseStart",
        "pulseEnd",
        "pulseDuration",
        "operator1",
        "operator2",
        "heatingInformation",
        "coolantInformation",
        "thermocoupleInformation",
        "comment",
        "pulseQuality",
        "experimentNumber",
        "configurationUUID",
        "diagnostics"
    ]
}
