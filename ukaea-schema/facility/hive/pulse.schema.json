{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fuel/schemas/1.0.0/facility/hive/pulse",
  "description": "Metadata schema for a HIVE pulse",
  "type": "object",
  "required": [
    "pulseID",
    "firstOperator",
    "secondOperator",
    "pulseStart",
    "pulseDuration",
    "dataCaptureStart",
    "pulseQuality",
    "heatingInformation",
    "coolantInformation"
  ],
  "properties": {
    "pulseInformation": {
      "type": "object",
      "properties": {
        "pulseID": {
          "type": "string"
        },
        "experiment": {
          "type": "string"
        },
        "configuration": {
          "type": "string"
        },
        "pulseStart": {
          "type": "string",
          "format": "date-time"
        },
        "dataCaptureStart": {
          "type": "string",
          "format": "date-time"
        },
        "pulseDuration": {
          "$comment": "To be updated automatically post-pulse",
          "type": "integer",
          "minimum": 0,
          "unit": "qudt:SEC"
        }
      }
    },
    "operator1": {
      "$ref": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/person"
    },
    "operator2": {
      "$ref": "https://w3id.org/fuel/schemas/1.0.0/diagnostics/person"
    },
    "pulseDetails": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "pulseQuality": {
          "enum": [ "Success", "Fail" ]
        }
      }
    },
    "heatingInformation": {
      "type": "object",
      "properties": {
        "currentType": {
          "enum": [ "AC", "DC" ]
        }, 
        "inputPower": {
          "type": "number",
          "unit": "qudt:KiloW"
        },
        "inputCurrent": {
          "type": "number",
          "unit": "qudt:A"
        }, 
        "inputVoltage": {
          "type": "number",
          "unit": "qudt:V"
        }
      }
    },
    "coolantInformation": {
      "type": "object",
      "required": [
        "coolantType",
        "targetCoolantFlow",
        "targetCoolantTemperature"
      ],
      "properties": {
        "coolantType": {
          "type": "string"
        },
        "targetCoolantFlow": {
          "type": "string"
        },
        "targetCoolantTemperature": {
          "type": "string"
        }
      }
    }
  }
}
