{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/facility/hive/pulse",
    "description": "Metadata schema for a HIVE pulse",
    "type": "object",
    "properties": {
        "sampleNumber": {
            "type": "integer"
        },
        "operator1": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [
                "email",
                "firstName",
                "lastName"
            ]
        },
        "operator2": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [
                "email",
                "firstName",
                "lastName"
            ]
        },
        "heatingInformation": {
            "type": "object",
            "properties": {
                "heatingType": {
                    "enum": [
                        "Induction",
                        "DC"
                    ]
                },
                "currentType": {
                    "enum": [
                        "AC",
                        "DC"
                    ]
                },
                "inputPower": {
                    "type": "number",
                    "unit": "qudt:KiloW"
                },
                "inputCurrent": {
                    "type": "number",
                    "unit": "qudt:A"
                },
                "inputVoltage": {
                    "type": "number",
                    "unit": "qudt:V"
                },
                "outputCurrent": {
                    "type": "number"
                }
            },
            "required": [
                "heatingType",
                "currentType",
                "outputCurrent"
            ],
            "if": {
                "properties": {
                    "currentType": {
                        "const": "DC"
                    }
                }
            },
            "then": {
                "required": [
                    "inputPower",
                    "inputCurrent",
                    "inputVoltage"
                ]
            }
        },
        "coolantInformation": {
            "type": "object",
            "properties": {
                "sampleCooling": {
                    "type": "boolean"
                },
                "coolantType": {
                    "type": "string"
                },
                "targetCoolantFlow": {
                    "type": "number"
                },
                "targetCoolantTemperature": {
                    "type": "number"
                },
                "measuredCoolantFlow": {
                    "type": "number"
                }
            },
            "required": [
                "sampleCooling"
            ],
            "if": {
                "properties": {
                    "sampleCooling": {
                        "const": "yes"
                    }
                }
            },
            "then": {
                "required": [
                    "coolantType",
                    "targetCoolantFlow",
                    "targetCoolantTemperature",
                    "measuredCoolantFlow"
                ]
            }
        },
        "comment": {
            "type": "string"
        },
        "pulseQuality": {
            "enum": [
                "Success",
                "Fail"
            ]
        },
        "experimentNumber": {
            "type": "integer"
        },
        "configurationId": {
            "type": "string",
            "format": "uuid"
        },
        "diagnostics": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "minItems": 1
            }
        },
        "schemaVersion": {
            "type": "string"
        }
    },
    "required": [
        "sampleNumber",
        "operator1",
        "operator2",
        "heatingInformation",
        "coolantInformation",
        "comment",
        "pulseQuality",
        "experimentNumber",
        "configurationId",
        "diagnostics",
        "schemaVersion"
    ]
}