{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fuel/schemas/1.0.0/facility/hive/pulse",
    "description": "Metadata schema for a HIVE pulse",
    "type": "object",
    "required": [
        "pulseInformation",
        "operator1",
        "operator2",
        "heatingInformation",
        "coolantInformation"
    ],
    "properties": {
        "pulseInformation": {
            "type": "object",
            "required": [
                "pulseUUID",
                "experimentUUID",
                "configurationUUID",
                "pulseStart",
                "pulseDuration",
                "dataCaptureStart",
                "comment",
                "pulseQuality"
            ],
            "properties": {
                "pulseUUID": {
                    "type": "string",
                    "format": "uuid",
                    "pre-pulse": true
                },
                "experimentUUID": {
                    "type": "string",
                    "format": "uuid",
                    "pre-pulse": true
                },
                "configurationUUID": {
                    "type": "string",
                    "format": "uuid",
                    "pre-pulse": true
                },
                "pulseStart": {
                    "type": "string",
                    "format": "date-time",
                    "pre-pulse": true
                },
                "dataCaptureStart": {
                    "type": "string",
                    "format": "date-time",
                    "pre-pulse": true
                },
                "pulseDuration": {
                    "type": "integer",
                    "unit": "qudt:SEC",
                    "minimum": 0,
                    "$comment": "To be updated automatically post-pulse"
                },
                "comment": {
                    "type": "string"
                },
                "pulseQuality": {
                    "enum": [
                        "Success",
                        "Fail"
                    ]
                }
            }
        },
        "operator1": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [
                "email",
                "firstName",
                "lastName"
            ],
            "pre-pulse": true
        },
        "operator2": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [
                "email",
                "firstName",
                "lastName"
            ],
            "pre-pulse": true
        },
        "coilInformation": {
            "type": "object",
            "properties": {
                "currentType": {
                    "enum": [
                        "AC",
                        "DC"
                    ],
                    "pre-pulse": true
                },
                "inputPower": {
                    "type": "number",
                    "unit": "qudt:KiloW",
                    "pre-pulse": true
                },
                "inputCurrent": {
                    "type": "number",
                    "unit": "qudt:A",
                    "pre-pulse": true
                },
                "inputVoltage": {
                    "type": "number",
                    "unit": "qudt:V",
                    "pre-pulse": true
                },
                "measuredPower": {
                    "type": "number"
                },
                "outputFrequency": {
                    "type": "number"
                },
                "outputVoltage": {
                    "type": "number"
                },
                "ouputCurrent": {
                    "type": "number"
                }
            },
            "required": [
                "currentType",
                "inputPower",
                "inputCurrent",
                "inputVoltage"
            ]
        },
        "coolantInformation": {
            "type": "object",
            "required": [
                "coolantType",
                "targetCoolantFlow",
                "targetCoolantTemperature"
            ],
            "properties": {
                "coolantType": {
                    "type": "string",
                    "pre-pulse": true
                },
                "targetCoolantFlow": {
                    "type": "number",
                    "pre-pulse": true
                },
                "targetCoolantTemperature": {
                    "type": "number",
                    "pre-pulse": true
                },
                "measuredCoolantFlow": {
                    "type": "number"
                },
                "coolantFlowVariance": {
                    "type": "number"
                },
                "coolantPressureIn": {
                    "type": "number"
                },
                "coolantPressureOut": {
                    "type": "number"
                },
                "deltaPressure": {
                    "type": "number"
                },
                "coolantTemperatureIn": {
                    "type": "number"
                },
                "coolantTemperatureInVariance": {
                    "type": "number"
                },
                "coolantTemperatureOut": {
                    "type": "number"
                },
                "coolantTemperatureOutVariance": {
                    "type": "number"
                },
                "deltaTemperature": {
                    "type": "number"
                }
            }
        }
    }
}
