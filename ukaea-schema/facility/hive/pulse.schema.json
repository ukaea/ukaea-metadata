{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fuel/schemas/1.0.0/facility/hive/pulse",
    "description": "Metadata schema for a HIVE pulse",
    "type": "object",
    "required": [
        "pulseInformation",
        "operator1",
        "operator2",
        "heatingInformation",
        "coolantInformation"
    ],
    "properties": {
        "pulseInformation": {
            "type": "object",
            "required": [
                "pulseUUID",
                "experimentUUID",
                "configurationUUID",
                "pulseStart",
                "pulseDuration",
                "dataCaptureStart",
                "comment",
                "pulseQuality"
            ],
            "properties": {
                "pulseUUID": {
                    "type": "string",
                    "format": "uuid"
                },
                "experimentUUID": {
                    "type": "string",
                    "format": "uuid"
                },
                "configurationUUID": {
                    "type": "string",
                    "format": "uuid"
                },
                "pulseStart": {
                    "type": "string",
                    "format": "date-time"
                },
                "dataCaptureStart": {
                    "type": "string",
                    "format": "date-time"
                },
                "pulseDuration": {
                    "type": "integer",
                    "unit": "qudt:SEC",
                    "minimum": 0,
                    "$comment": "To be updated automatically post-pulse"
                },
                "comment": {
                    "type": "string"
                },
                "pulseQuality": {
                    "enum": [
                        "Success",
                        "Fail"
                    ]
                }
            }
        },
        "operator1": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": [ "email", "firstName", "lastName" ]
        },
        "operator2": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            },
            "required": ["email", "firstName", "lastName"]
        },
        "heatingInformation": {
            "type": "object",
            "properties": {
                "currentType": {
                    "enum": [ "AC", "DC" ]
                },
                "inputPower": {
                    "type": "number",
                    "unit": "qudt:KiloW"
                },
                "inputCurrent": {
                    "type": "number",
                    "unit": "qudt:A"
                },
                "inputVoltage": {
                    "type": "number",
                    "unit": "qudt:V"
                }
            }
        },
        "coolantInformation": {
            "type": "object",
            "required": [
                "coolantType",
                "targetCoolantFlow",
                "targetCoolantTemperature"
            ],
            "properties": {
                "coolantType": {
                    "type": "string"
                },
                "targetCoolantFlow": {
                    "type": "number"
                },
                "targetCoolantTemperature": {
                    "type": "number"
                }
            }
        }
    }
}
