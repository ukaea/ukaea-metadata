{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:ukaea:process-schema",
    "description": "Metadata schema for PROCESS simulations",
    "type": "object",
    "properties": {
        "runInformation": {
            "type": "object",
            "properties": {
                "runTitle": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "dateTime": {
                    "type": "string",
                    "format": "date-time"
                },
                "Pfus": {
                    "type": "number"
                },
                "Pnet": {
                    "type": "number"
                },
                "R": {
                    "type": "number"
                },
                "A": {
                    "type": "number"
                },
                "B": {
                    "type": "number"
                }
            },
            "required": [
                "runTitle",
                "author",
                "dateTime",
                "Pfus",
                "Pnet",
                "R",
                "A",
                "B"
            ]
        }
    }
}