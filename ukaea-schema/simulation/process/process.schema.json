{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:ukaea:process-schema",
    "description": "Metadata schema for PROCESS simulations",
    "type": "object",
    "properties": {
        "runInformation": {
            "type": "object",
            "properties": {
                "runTitle": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "version": {
                    "type": "string",
                    "description": "Version of the simulation code used"
                },
                "fusionPower": {
                    "type": "number",
                    "description": "Fusion power in MW"
                },
                "netPower": {
                    "type": "number",
                    "description": "Net power in MW"
                },
                "majorRadius": {
                    "type": "number",
                    "description": "Major radius in m"
                },
                "aspectRatio": {
                    "type": "number",
                    "description": "Aspect ratio"
                },
                "B_tor": {
                    "type": "number",
                    "description": "Vacuum torodial field on-axis in T"
                }
            },
            "required": [
                "runTitle",
                "author",
                "fusionPower",
                "netPower",
                "majorRadius",
                "aspectRatio",
                "B_tor"
            ]
        }
    }
}