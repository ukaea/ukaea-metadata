{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UKAEA Experiment Schema",
  "type": "object",
  "properties": {
    "facility": {
      "type": "string"
    },
    "facilityExperimentID": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "leadInvestigator": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        }
      }
    },
    "customer": {
      "type": "object",
      "properties": {
        "organisation": {
          "type": "string"
        },
        "contactPerson": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "firstName": {
              "type": "string"
            },
            "lastName": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "facility",
    "facilityExperimentID",
    "startDate",
    "description"
  ]
}