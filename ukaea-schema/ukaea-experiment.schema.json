{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/fusion/schemas/1.0.0/ukaea-experiment",
    "title": "UKAEA Experiment Schema",
    "type": "object",
    "properties": {
        "facility": {
            "type": "string"
        },
        "facilityExperimentId": {
            "type": "string"
        },
        "startDate": {
            "type": "string",
            "format": "date"
        },
        "endDate": {
            "type": "string",
            "format": "date"
        },
        "description": {
            "type": "string"
        },
        "leadInvestigator": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "firstName": {
                    "type": "string"
                },
                "lastName": {
                    "type": "string"
                }
            }
        },
        "customer": {
            "type": "object",
            "properties": {
                "organisation": {
                    "type": "string"
                },
                "contactPerson": {
                    "type": "object",
                    "properties": {
                        "email": {
                            "type": "string",
                            "format": "email"
                        },
                        "firstName": {
                            "type": "string"
                        },
                        "lastName": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "schemaVersion": {
            "type": "string"
        }
    },
    "required": [
        "facility",
        "facilityExperimentId",
        "startDate",
        "description",
        "schemaVersion"
    ]
}